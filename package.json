{
  "name": "micro-sol-signer",
  "version": "0.8.2",
  "description": "Create, sign & decode Solana transactions with minimum deps",
  "files": [
    "*.js",
    "*.d.ts",
    "idl",
    "src"
  ],
  "dependencies": {
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@scure/base": "2.3.0",
    "micro-packed": "0.11.0"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.7.1",
    "@types/node": "26.3.0",
    "bismar": "0.1.8",
    "micro-ftch": "1.2.0",
    "prettier": "3.8.3",
    "typescript": "6.0.3"
  },
  "scripts": {
    "benchmark:size": "bismar -bsm",
    "build": "tsc",
    "build:clean": "rm -f *.{js,d.ts,d.ts}; rm -rf idl",
    "format": "prettier --write src",
    "test": "node test/index.ts"
  },
  "exports": {
    ".": "./index.js",
    "./hint.js": "./hint.js",
    "./net.js": "./net.js",
    "./offchain.js": "./offchain.js",
    "./idl.js": "./idl/index.js"
  },
  "keywords": [
    "solana",
    "sol",
    "web3",
    "sign",
    "signer",
    "tx",
    "transaction",
    "address",
    "token"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/micro-sol-signer.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
